{
  "name": "weft",
  "version": "0.1.0",
  "private": true,
  "description": "Weft \u2014 coordination-first version control for many agents, on Cloudflare Workers + Artifacts.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.worker-tests.json",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.28.0",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "web-tree-sitter": "0.27.0",
    "zod": "^4.6.7"
  },
  "bin": {
    "weft": "./cli/weft.ts"
  }
}
